<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Puzzle15Game" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/jungle</item>
    </style>

    <!-- Tizim splash'i ilovadagi splash bilan bir xil yashil, oq ekran chaqnamasin. -->
    <style name="Theme.Puzzle15Game.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/jungle</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_splash_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Puzzle15Game</item>
    </style>
</resources>
