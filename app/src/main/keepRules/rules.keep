# R8 keep rules; AGP merges every file in src/main/keepRules.
# Libraries (Firebase, Room, Hilt, kotlinx.serialization) ship their own consumer rules.

# Readable crash stack traces.
-keepattributes SourceFile,LineNumberTable
-renamesourcefileattribute SourceFile

# Navigation 3 saves the back stack by serializing these route objects.
-keep class uz.visionsystemscorp.puzzle15game.navigation.** implements androidx.navigation3.runtime.NavKey { *; }

# Credential Manager finds its Play Services provider by reflection.
-if class androidx.credentials.CredentialManager
-keep class androidx.credentials.playservices.** { *; }
