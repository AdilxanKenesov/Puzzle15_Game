# R8 qoidalari. Kutubxonalar (Firebase, Room, Hilt, kotlinx.serialization) o'z qoidalarini o'zi olib keladi.

# Crash stack trace'lari o'qiladigan bo'lsin.
-keepattributes SourceFile,LineNumberTable
-renamesourcefileattribute SourceFile

# Navigation 3 back stack'ni shu route obyektlarini serializatsiya qilib saqlaydi.
-keep class uz.visionsystemscorp.puzzle15game.navigation.** implements androidx.navigation3.runtime.NavKey { *; }

# Credential Manager Play Services provider'ini reflection orqali topadi.
-if class androidx.credentials.CredentialManager
-keep class androidx.credentials.playservices.** { *; }
